# dependencies
/node_modules
/.pnp
.pnp.js
.pnp.cjs
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/
next-env.d.ts

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------
# secrets and credentials — nothing below here should ever be committed
# ---------------------------------------------------------------

# environment files (all variants, including .env itself)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# keys, certificates, and credential bundles
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der
*.keystore
*.jks
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk

# cloud and service-provider credentials
.aws/
.gcp/
gcp-*.json
*-service-account.json
service-account*.json
credentials.json
client_secret*.json
.netrc
.npmrc
.pypirc
secrets.json
secrets.yaml
secrets.yml
*.secrets

# tool and platform local state
.vercel
.netlify
.firebase/
.serverless/
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# local databases and dumps (can contain real user data)
*.sqlite
*.sqlite3
*.db
*.sql
*.dump

# editor and OS local config
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# agent/session local state
.claude/settings.local.json

# design review captures (regenerated each review round)
.impeccable/review/
.impeccable/build/
.impeccable/questions/

# vendor build output, copied in by scripts/copy-pdf-worker.mjs
/public/pdf.worker.min.mjs

# migrations are source, not a database dump
!supabase/migrations/*.sql
