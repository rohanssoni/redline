# Copy to .env.local and fill in. .env.local is gitignored; never commit a key.

# The model, through OpenRouter. Both are required before an analysis can run.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Supabase, for accounts and the document store. Redline starts and analyses a
# document without these; sign-in and the library say they aren't set up yet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
